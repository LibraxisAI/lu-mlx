# direnv: this directory is the Tauri crate, not the Loctree/Tauri app root.
# Prepend scripts/bin so `loct` hits scripts/assert-loct-repo-root.sh before
# any scan. The sentinel FILE .loctree only blocks mkdir of a nested
# snapshot dir; loct scan still writes ~/Library/Caches/loctree/projects/<id>.
source_up_if_exists
PATH_add ../scripts/bin
